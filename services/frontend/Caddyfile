:80 {
	root * /srv
	encode gzip

	# Vite names every built file by its content hash, so the browser keeps it for good.
	# A missing asset is a 404, never index.html, so HTML is not cached under a script's name.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html and the favicon are revalidated on every load, so a redeploy shows at once.
	handle {
		header Cache-Control "no-cache"
		rewrite /favicon.ico /favicon.svg
		try_files {path} /index.html
		file_server
	}
}
