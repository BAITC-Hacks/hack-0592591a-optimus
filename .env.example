# Copy to .env. The app must boot with these values exactly as they are.
# Every new variable goes here (with a comment), in your local .env,
# and in /etc/hackalem/app.env on the VM.

# Public entrypoint. Locally: http://localhost:3000
# ":80" = plain HTTP. On the VM this is the public hostname, which turns on HTTPS.
SITE_ADDRESS=:80
WEB_PORT=3000
HTTPS_PORT=3443

# MongoDB connection string as seen from inside the compose network.
# The backend connects at startup and reports the DB in GET /api/health.
MONGO_URL=mongodb://mongo:27017/hackalem

# Largest accepted document upload (Word/PDF/Excel), in megabytes.
MAX_UPLOAD_MB=20

# Secret that signs session cookies (JWT). Any long random string. The default
# exists only so the app boots from this file as is; set your own on the VM.
AUTH_SECRET=dev-only-secret-change-me

# Synthetic demo account for reviewers, created at backend start if missing.
# Compose uses the demo defaults when these values are empty.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo12345
DEMO_USER_NAME=Демо

# LLM access. AI features fail with a clear message while the key is empty.
# Reviewers get a working value as described in README "Access for reviewers".
LLM_PROVIDER=openai
LLM_MODEL=
LLM_BASE_URL=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Embedding model on the same LLM endpoint (semantic fallback when matching
# functions «до» ↔ «после»). Empty = skip embeddings and use lexical
# candidates only; the analysis still completes.
EMBEDDING_MODEL=
