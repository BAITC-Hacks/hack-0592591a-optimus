{
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker run --rm:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(make:*)",
      "Bash(./scripts/smoke.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull --rebase:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(brew install:*)",
      "Read(./.env)"
    ]
  }
}
